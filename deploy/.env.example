# Másold a VPS-en a DEPLOY_PATH könyvtárba .env néven.
# A workflow nem írja felül a meglévő .env fájlt.
# A konténerben a DATABASE_HOST=mysql és a DATABASE_PORT=3306 felülíródik.
# A VPS-en kívülről: alkalmazás 4001, phpMyAdmin 4011, MySQL 3037.

MYSQL_ROOT_PASSWORD="change-me-root"
DATABASE_USER="leave"
DATABASE_PASSWORD="change-me"
DATABASE_NAME="leave_management"

AUTH_SECRET="change-me"
APP_ORIGIN="https://szabadsag.example.com"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: allowed Google Workspace domains, comma-separated (e.g. virgo.hu,example.hu)
GOOGLE_HOSTED_DOMAIN=""

LDAP_URL=""
LDAP_BIND_DN=""
LDAP_BIND_PASSWORD=""
LDAP_SEARCH_BASE=""
LDAP_SEARCH_FILTER="(mail={{username}})"
LDAP_USER_DN_TEMPLATE=""
